# Local launcher opens /settings to save your OpenAI key. Never commit .env.
OPENAI_API_KEY=
LYRIC_GOAT_WRITER=openai
OPENAI_GENERATION_MODEL=gpt-6-luna
# Optional legacy writer: set LYRIC_GOAT_WRITER=anthropic and supply its key.
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
OPENAI_TIMING_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SEMANTIC_TRANSCRIPTION_MODEL=gpt-4o-transcribe
LYRIC_GOAT_TRANSCRIPTION_MODE=timed
MELODY_NOTE_PROVIDER=pyin
LYRIC_GOAT_DATA_DIR=data
LYRIC_GOAT_AUDIO_LISTENER=auto
OPENAI_LISTENING_MODEL=gpt-audio-1.5
